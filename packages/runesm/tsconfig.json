{
  "extends": "../../tsconfig.test.json",
  "include": ["src", "__tests__"],
  // Browser tests run page-side through the WebView harness (bun), not vitest.
  "exclude": ["__tests__/browser", "__tests__/fixtures"],
  "compilerOptions": {
    // Specify an output folder for all emitted files.
    "outDir": "build",
    // Only output d.ts files and not JavaScript files.
    "emitDeclarationOnly": true,
    // The runner executes in browsers: DOM globals (Worker, URL, Blob, …) are part of its contract.
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  }
}
