{
  "extends": "../../tsconfig.test.json",
  "include": ["src", "scripts", "__tests__", "vite.config.ts"],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    // An app never emits declarations; declaration-emit strictness doesn't apply.
    "isolatedDeclarations": false,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "src": ["${configDir}/src/main.ts"],
      "src/*": ["${configDir}/src/*"]
    }
  }
}
